---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../lib/site';
interface Props { title?: string; description?: string; overlayHeader?: boolean; ogImage?: string; noindex?: boolean }
const c = await company();
const { title, description = c.positioning, overlayHeader = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${c.short_name}` : `${c.short_name} | ${c.tagline}`;
const preview = import.meta.env.PUBLIC_PREVIEW === 'true';
const orgLd = {
  '@context': 'https://schema.org', '@type': 'Organization', name: c.short_name, legalName: c.legal_name,
  foundingDate: String(c.founded), url: Astro.site?.href, slogan: c.tagline,
  address: c.offices?.filter((o) => o.primary).map((o) => ({ '@type': 'PostalAddress', streetAddress: o.lines[0], addressLocality: 'New York', addressRegion: 'NY', postalCode: '10006', addressCountry: 'US' })),
  telephone: c.offices?.find((o) => o.primary)?.phone,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Shippori+Mincho+B1:wght@400;500&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
