---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../lib/site';
interface Props { title?: string; description?: string; overlayHeader?: boolean; ogImage?: string; noindex?: boolean }
const c = await company();
const { title, description = c.positioning, overlayHeader = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${c.short_name}` : `${c.short_name} | ${c.tagline}`;
const preview = import.meta.env.PUBLIC_PREVIEW === 'true';
const orgLd = {
  '@context': 'https://schema.org', '@type': 'Organization', name: c.short_name, legalName: c.legal_name,
  foundingDate: String(c.founded), url: Astro.site?.href, slogan: c.tagline,
  address: c.offices?.filter((o) => o.primary).map((o) => ({ '@type': 'PostalAddress', streetAddress: o.lines[0], addressLocality: 'New York', addressRegion: 'NY', postalCode: '10006', addressCountry: 'US' })),
  telephone: c.offices?.find((o) => o.primary)?.phone,
};
---
<!doctype html>
<html lang="en" data-type="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&family=Shippori+Mincho+B1:wght@400;500&family=Schibsted+Grotesk:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script is:inline>
      try { const t = localStorage.getItem('ral-type'); if (t === 'b') document.documentElement.dataset.type = 'b'; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main"><slot /></main>
    <Footer />
    {preview && (
      <div class="typeswitch" role="group" aria-label="Typography preview">
        <span>Type</span>
        <button type="button" data-t="a">A</button>
        <button type="button" data-t="b">B</button>
      </div>
    )}
  </body>
</html>
<style is:global>
  .typeswitch { position: fixed; right: 1rem; bottom: calc(1rem + env(safe-area-inset-bottom, 0px)); z-index: 60; display: flex; align-items: center; gap: 0.25rem; background: var(--paper); border: 1px solid var(--rule-strong); padding: 0.25rem 0.25rem 0.25rem 0.75rem; font: 600 0.6875rem/1 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; box-shadow: 0 2px 12px rgb(0 0 0 / 0.08); }
  .typeswitch button { font: inherit; border: 0; background: none; padding: 0.5rem 0.65rem; cursor: pointer; color: var(--graphite); }
  html[data-type='a'] .typeswitch [data-t='a'], html[data-type='b'] .typeswitch [data-t='b'] { background: var(--ink); color: var(--paper); }
</style>
<script>
  document.querySelectorAll('.typeswitch button').forEach((b) =>
    b.addEventListener('click', () => {
      const t = (b as HTMLElement).dataset.t!;
      document.documentElement.dataset.type = t;
      try { localStorage.setItem('ral-type', t); } catch (e) {}
    }),
  );
</script>
