---
import Img from './Img.astro';
const { p, roles = {}, types = {} } = Astro.props;
const d = p.data;
const typeLabel = d.types.map((t: any) => types[t.id]?.label).filter(Boolean).join(' · ');
---
<article class="pcard">
  {d.card_image
    ? <div class="frame" style="aspect-ratio:3 / 2"><Img src={d.card_image} alt={d.card_alt ?? d.name} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 30vw" widths={[480, 800, 1200]} /></div>
    : <div class="pcard__plate" aria-hidden="true"><span class="label">{d.location}</span><span class="pcard__plate-name">{d.name}</span></div>}
  <div class="pcard__body">
    <h3 class="pcard__name">{d.name}</h3>
    <p class="meta">{d.location}</p>
    {typeLabel && <p class="label pcard__type">{typeLabel}</p>}
    {d.hook && <p class="pcard__hook meta">{d.hook}</p>}
  </div>
</article>
<style>
  .pcard__plate { aspect-ratio: 3 / 2; background: var(--stone-2); border: 1px solid var(--rule); display: flex; flex-direction: column; justify-content: space-between; padding: 1.25rem; color: var(--graphite); }
  .pcard__plate-name { font-family: var(--font-display); font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem); line-height: 1.1; color: var(--ink); }
  .pcard__body { padding-top: 0.9rem; display: grid; gap: 0.15rem; }
  .pcard__name { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 1.25rem; line-height: 1.25; }
  .pcard__type { color: var(--graphite); margin-top: 0.5rem; font-size: 0.6875rem; }
  .pcard__hook { margin-top: 0.4rem; max-width: 30em; }
</style>
